---
import Base from "../layouts/Base.astro";

const experience = [
  {
    when: "’24 — now",
    role: "Staff Software Engineer, Data",
    org: "Lyric",
    bullets: [
      "Led a zero-downtime ClickHouse engine upgrade with 100% backward compatibility for existing customer queries.",
      "Migrated HadoopCatalog → Project Nessie: 3M+ table metadata entries across 30+ isolated customer environments, with zero data corruption or interruption.",
      "Architected multi-environment branching via Nessie for “what-if” analysis — simulating scenarios before finalizing plan versions, with infra ready for agentic scale.",
      "Leading an initiative to cut Spark compute via catalog integrations and zero-copy append/overwrite strategies, reducing infra cost for low-complexity operations.",
    ],
  },
  {
    when: "’21 — ’24",
    role: "SDE 3, Data Platform",
    org: "Navi Technologies",
    note: "Scalable platform solutions, EMR cost/performance optimization, and data integration with a modern stack (Airbyte, dbt).",
  },
  {
    when: "’18 — ’21",
    role: "Senior Engineer, Big Data",
    org: "Fractal Analytics",
    note: "Built data lakes and real-time pipelines, achieving significant throughput and latency gains.",
  },
  {
    when: "’15 — ’18",
    role: "Software Engineer",
    org: "Syntel",
    note: "Real-time ingestion and processing on Kafka, NiFi, and Hadoop.",
  },
];

const work = [
  {
    title: "Real-time data streaming",
    note: "Ingested ~150 GB/day from Oracle GoldenGate into Kafka, processed via Spark micro-batches to power a live dashboard.",
  },
  {
    title: "Metadata management platform",
    note: "Observer-pattern lineage tracking enabling seamless downstream enrichment.",
  },
  {
    title: "Auto-suggestion chatbot",
    note: "Elasticsearch-backed chatbot with entity recognition and query auto-suggestions.",
  },
];
---

<Base title="Anuj Shirgaonkar — Staff Software Engineer">
  <header class="topbar">
    <span class="id">anuj shirgaonkar</span>
    <nav>
      <a href="#work">work</a>
      <button class="theme-toggle" type="button" aria-label="Toggle dark mode">
        <svg class="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
        <svg class="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
      </button>
    </nav>
  </header>

  <section class="hero">
    <h1>Anuj Shirgaonkar</h1>
    <div class="role">Staff Software Engineer · Data Platforms &amp; Infrastructure</div>
    <p class="lede">
      I build robust, scalable data platforms — the pipelines, lakes, and
      self-serve analytics that turn raw events into something teams can
      actually use.
    </p>
  </section>

  <section id="experience">
    <div class="label">Experience</div>
    {experience.map((e) => (
      <div class="entry">
        <div class="when">{e.when}</div>
        <div class="what">
          <h3>{e.role}</h3>
          <div class="org">{e.org}</div>
          {e.note && <p>{e.note}</p>}
          {e.bullets && (
            <ul>
              {e.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </div>
      </div>
    ))}
  </section>

  <section id="work">
    <div class="label">Selected work</div>
    {work.map((w) => (
      <div class="entry">
        <div class="when">↳</div>
        <div class="what">
          <h3>{w.title}</h3>
          <p>{w.note}</p>
        </div>
      </div>
    ))}
  </section>

  <footer>
    <span>Bengaluru · India</span>
    <span class="links">
      <a class="icon-link" href="https://www.linkedin.com/in/anuj-shirgaonkar" aria-label="LinkedIn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z" />
        </svg>
      </a>
      <a class="icon-link" href="https://github.com/anjshrg" aria-label="GitHub">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.65 7.65 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
        </svg>
      </a>
      <a href="mailto:shirgaonkar.anuj@gmail.com">email</a>
    </span>
  </footer>
</Base>
